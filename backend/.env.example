# =============================================================================
# LangConfig Backend Environment Variables
# =============================================================================
# The root .env file is canonical and is loaded by the backend.
# Copy this file to backend/.env only when you need backend-only overrides.
# DO NOT commit .env to version control - it contains sensitive credentials

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development  # Options: development, production, testing
DEBUG=true  # Set to false in production for less verbose logging

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=300

# =============================================================================
# Google OAuth (for Presentation Generator - Google Slides export)
# =============================================================================
# Required for exporting presentations to Google Slides
# See docs/GOOGLE_OAUTH_SETUP.md for setup instructions
#
# 1. Create OAuth credentials at https://console.cloud.google.com/
# 2. Enable Google Slides API and Google Drive API
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add redirect URI: http://localhost:8780/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# =============================================================================
# Encryption Key
# =============================================================================
# Prefer setting APP_ENCRYPTION_KEY in the root .env file. Generate it with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit or share this value.
APP_ENCRYPTION_KEY=

# Experimental local API boundary
# Enables Codex, Hermes, and Platform Brain routes for loopback clients only.
# Keep false on shared, proxied, remote, or hosted backends.
ENABLE_EXPERIMENTAL_LOCAL_APIS=false
