{
  "name": "langconfig",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/check-build.mjs",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "format:check": "biome format",
    "format": "biome format --write",
    "check:interfaces": "npm run lint && npm run format:check && npm run typecheck",
    "format:interfaces": "npm run format",
    "preview": "vite preview",
    "tauri": "tauri",
    "start:docker": "docker compose up -d postgres",
    "start:backend": "cd backend && python -m uvicorn main:app --reload --port 8780",
    "start:all": "npm run start:docker && concurrently --names \"BACKEND,FRONTEND\" -c \"bgBlue,bgGreen\" \"npm run start:backend\" \"npm run dev\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-query": "^5.90.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-opener": "^2",
    "animejs": "^4.2.2",
    "axios": "^1.15.0",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "html2canvas-oklch": "^1.5.0-alpha.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.25",
    "lucide-react": "^0.546.0",
    "marked": "^17.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.12.0",
    "react-syntax-highlighter": "^16.1.0",
    "reactflow": "^11.11.4",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "three": "^0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.16",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.8.3",
    "vite": "^7.3.2"
  }
}
